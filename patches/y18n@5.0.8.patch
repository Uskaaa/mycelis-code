diff --git a/build/index.cjs b/build/index.cjs
index b2731e1a53de43288b7c0705ee9c2b5d96a9f44e..7f76141894f2a905ba5276e37e21ece31df94653 100644
--- a/build/index.cjs
+++ b/build/index.cjs
@@ -144,11 +144,11 @@ class Y18N {
         catch (err) {
             if (err instanceof SyntaxError) {
                 err.message = 'syntax error in ' + languageFile;
-            }
-            if (err.code === 'ENOENT')
-                localeLookup = {};
-            else
                 throw err;
+            }
+            // mycelis_change - see build/lib/index.js's copy of this function for why this now
+            // treats any read failure (not just 'ENOENT') as "no locale data" instead of crashing.
+            localeLookup = {};
         }
         this.cache[this.locale] = localeLookup;
     }
diff --git a/build/lib/index.js b/build/lib/index.js
index e38f33594c158b6335ef049f35a0ed18abf7d2d0..bd922e13335ed42c8056073bbb91314b63edeb4d 100644
--- a/build/lib/index.js
+++ b/build/lib/index.js
@@ -138,11 +138,16 @@ class Y18N {
         catch (err) {
             if (err instanceof SyntaxError) {
                 err.message = 'syntax error in ' + languageFile;
-            }
-            if (err.code === 'ENOENT')
-                localeLookup = {};
-            else
                 throw err;
+            }
+            // mycelis_change - locale files are an optional nicety, not something worth crashing
+            // the whole CLI over. Originally only 'ENOENT' (file genuinely missing) was treated
+            // this way; broadened to any read failure after hitting a Bun --compile quirk on
+            // Windows where a real "B:" drive letter collides with Bun's internal "B:\~BUN\"
+            // virtual filesystem prefix, making this read fail with 'EUNKNOWN' instead of
+            // 'ENOENT' even though the bundled locale file is right there
+            // (github.com/Kilo-Org/kilocode/issues/9197).
+            localeLookup = {};
         }
         this.cache[this.locale] = localeLookup;
     }
